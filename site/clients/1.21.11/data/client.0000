<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="data:,">
  <title></title>
  <style>
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      background: #050505;
      color: #d8d8d8;
      font: 14px/1.45 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    #mc-canvas {
      display: block;
      width: 100vw;
      height: 100vh;
      background: #000;
      outline: none;
    }

    #status {
      position: fixed;
      top: 12px;
      left: 12px;
      right: 12px;
      max-height: 46vh;
      overflow: auto;
      box-sizing: border-box;
      padding: 10px 12px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 6px;
      background: rgba(0, 0, 0, 0.72);
      white-space: pre-wrap;
      pointer-events: none;
    }

    #status[data-state="running"] { color: #7dd3fc; }
    #status[data-state="error"] { color: #ff8787; }

    #boot-progress {
      position: fixed;
      left: 12px;
      right: 12px;
      top: min(50vh, 178px);
      height: 16px;
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 4px;
      background: rgba(0, 0, 0, 0.72);
      overflow: hidden;
      pointer-events: none;
    }

    #boot-progress-bar {
      width: 2%;
      height: 100%;
      background: #54d68b;
      transition: width 180ms linear;
    }

    #boot-progress-text {
      position: fixed;
      left: 12px;
      right: 12px;
      top: calc(min(50vh, 178px) + 22px);
      color: #d8f3ff;
      text-shadow: 0 1px 2px #000;
      pointer-events: none;
      font-size: 12px;
    }

    #perf-hud {
      position: fixed;
      top: 12px;
      right: 12px;
      z-index: 20;
      min-width: 176px;
      box-sizing: border-box;
      padding: 8px 10px;
      border: 1px solid rgba(125, 211, 252, 0.35);
      border-radius: 6px;
      background: rgba(0, 0, 0, 0.58);
      color: #c7f9ff;
      font: 12px/1.35 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      text-shadow: 0 1px 2px #000;
      pointer-events: none;
      white-space: pre;
    }

    #perf-hud[data-tier="warn"] {
      border-color: rgba(250, 204, 21, 0.55);
      color: #fde68a;
    }

    #perf-hud[data-tier="bad"] {
      border-color: rgba(248, 113, 113, 0.65);
      color: #fecaca;
    }
    /* Gaius boot screen */
    #boot-screen {
      position: fixed;
      inset: 0;
      z-index: 10;
      background: #101511;
      pointer-events: none;
    }

    #boot-brand {
      position: fixed;
      left: 50%;
      top: 38%;
      z-index: 11;
      transform: translate(-50%, -50%);
      color: #fff;
      text-align: center;
      font: 900 72px/0.82 Arial, Helvetica, sans-serif;
      letter-spacing: 0;
      text-shadow: 0 4px 0 rgba(0, 0, 0, 0.28);
      animation: gaius-logo-enter 420ms ease-out both;
      pointer-events: none;
    }

    #boot-brand span {
      display: block;
      margin-top: 16px;
      font-size: 0.28em;
      line-height: 1;
      letter-spacing: 0;
    }

    #boot-progress {
      left: 50%;
      right: auto;
      top: 58%;
      z-index: 11;
      width: min(460px, calc(100vw - 48px));
      height: 10px;
      box-sizing: border-box;
      padding: 2px;
      transform: translateX(-50%);
      border: 2px solid #fff;
      border-radius: 0;
      background: transparent;
    }

    #boot-progress-bar {
      min-width: 2px;
      background: #54d68b;
      transition: width 160ms linear;
    }

    #boot-progress-text {
      left: 24px;
      right: 24px;
      top: calc(58% + 24px);
      z-index: 11;
      color: #fff;
      text-align: center;
      font-size: 12px;
      text-shadow: none;
    }

    #status {
      left: 50%;
      right: auto;
      top: calc(58% + 56px);
      z-index: 11;
      width: min(640px, calc(100vw - 48px));
      max-height: 28vh;
      transform: translateX(-50%);
      border: 0;
      border-radius: 0;
      background: transparent;
      color: rgba(255, 255, 255, 0.9);
      text-align: center;
      font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    #status[data-state="error"] {
      padding: 14px 16px;
      border: 2px solid rgba(255, 255, 255, 0.82);
      background: rgba(0, 0, 0, 0.76);
      color: #fff;
      text-align: left;
    }
    @keyframes gaius-logo-enter {
      from { opacity: 0; transform: translate(-50%, -46%) scale(0.96); }
      to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    }

    @media (max-width: 600px) {
      #boot-brand { font-size: 44px; }
    }

    /* Gaius Client shell v2: browser launcher controls only. */
    :root {
      --gaius-shell-bg: #0b1116;
      --gaius-shell-panel: #111a21;
      --gaius-shell-panel-strong: #17232c;
      --gaius-shell-line: #31414c;
      --gaius-shell-muted: #9aaab4;
      --gaius-shell-text: #f1f5f7;
      --gaius-shell-accent: #9bd36a;
      --gaius-shell-accent-strong: #c3ec8f;
      --gaius-shell-danger: #f08a7b;
    }

    html,
    body {
      background: var(--gaius-shell-bg);
      color: var(--gaius-shell-text);
    }

    #mc-canvas {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      background: #05080a;
    }

    #boot-screen {
      z-index: 10;
      background: var(--gaius-shell-bg);
    }

    #boot-screen::before {
      position: absolute;
      inset: 18px;
      content: "";
      border: 1px solid rgba(155, 211, 106, 0.18);
      pointer-events: none;
    }

    #gaius-shell-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 12;
      display: flex;
      align-items: center;
      min-height: 56px;
      box-sizing: border-box;
      padding: 0 24px;
      border-bottom: 2px solid var(--gaius-shell-line);
      background: var(--gaius-shell-bg);
      pointer-events: none;
      transition: opacity 140ms linear, visibility 140ms linear;
    }

    #gaius-shell-brand {
      display: flex;
      align-items: baseline;
      gap: 10px;
      font: 800 15px/1 Arial, Helvetica, sans-serif;
      letter-spacing: 0;
    }

    #gaius-shell-brand strong {
      color: var(--gaius-shell-accent-strong);
      font-size: 19px;
    }

    #gaius-shell-mode,
    #gaius-shell-version {
      color: var(--gaius-shell-muted);
      font: 700 11px/1 Arial, Helvetica, sans-serif;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    #gaius-shell-mode {
      margin-left: auto;
      margin-right: 18px;
      color: var(--gaius-shell-accent);
    }

    #gaius-shell-footer {
      position: fixed;
      left: 24px;
      right: 24px;
      bottom: 18px;
      z-index: 12;
      display: flex;
      justify-content: space-between;
      gap: 16px;
      color: var(--gaius-shell-muted);
      font: 11px/1.4 Arial, Helvetica, sans-serif;
      letter-spacing: 0;
      pointer-events: none;
      transition: opacity 140ms linear, visibility 140ms linear;
    }

    #gaius-shell-footer strong {
      color: var(--gaius-shell-text);
      font-weight: 700;
    }

    html[data-gaius-shell-view="canvas"] #gaius-shell-header,
    html[data-gaius-shell-view="canvas"] #gaius-shell-footer {
      visibility: hidden;
      opacity: 0;
    }

    #boot-brand {
      top: 40%;
      z-index: 11;
      max-width: calc(100vw - 32px);
      color: var(--gaius-shell-text);
      font: 900 72px/0.84 Arial, Helvetica, sans-serif;
      letter-spacing: 0;
      text-shadow: 0 4px 0 #27343b;
    }

    #boot-brand span {
      margin-top: 14px;
      color: var(--gaius-shell-accent);
      font-size: 12px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    #boot-progress {
      top: 58%;
      z-index: 11;
      width: min(480px, calc(100vw - 48px));
      height: 14px;
      padding: 2px;
      border: 2px solid var(--gaius-shell-text);
      border-radius: 0;
      background: transparent;
    }

    #boot-progress-bar {
      min-width: 2px;
      background: var(--gaius-shell-accent);
      transition: width 160ms linear;
    }

    #boot-progress-text {
      top: calc(58% + 28px);
      z-index: 11;
      color: var(--gaius-shell-muted);
      font: 700 12px/1.4 Arial, Helvetica, sans-serif;
      letter-spacing: 0;
      text-align: center;
      text-shadow: none;
    }

    #status {
      top: calc(58% + 62px);
      z-index: 11;
      width: min(660px, calc(100vw - 48px));
      max-height: 22vh;
      box-sizing: border-box;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: var(--gaius-shell-muted);
      font: 12px/1.45 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      letter-spacing: 0;
      text-align: center;
    }

    #status[data-state="error"] {
      max-height: 25vh;
      overflow: auto;
      padding: 12px 14px;
      border: 2px solid var(--gaius-shell-danger);
      border-left-width: 5px;
      background: var(--gaius-shell-panel);
      color: var(--gaius-shell-text);
      text-align: left;
    }

    #gaius-error-actions {
      position: fixed;
      top: calc(58% + 190px);
      left: 50%;
      z-index: 12;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      width: min(660px, calc(100vw - 48px));
      transform: translateX(-50%);
    }

    #gaius-error-actions[hidden],
    #gaius-error-details[hidden] {
      display: none;
    }

    #gaius-error-actions button {
      min-height: 36px;
      box-sizing: border-box;
      padding: 0 14px;
      border: 2px solid var(--gaius-shell-line);
      border-radius: 0;
      background: var(--gaius-shell-panel-strong);
      color: var(--gaius-shell-text);
      font: 700 12px/1 Arial, Helvetica, sans-serif;
      letter-spacing: 0;
      cursor: pointer;
    }

    #gaius-error-actions button:first-child {
      border-color: var(--gaius-shell-accent);
      background: var(--gaius-shell-accent);
      color: #0b1116;
    }

    #gaius-error-actions button:hover,
    #gaius-error-actions button:focus-visible {
      outline: 2px solid var(--gaius-shell-text);
      outline-offset: 2px;
    }

    #gaius-error-actions button:disabled {
      cursor: wait;
      opacity: 0.65;
    }

    #gaius-error-details {
      position: fixed;
      top: calc(58% + 238px);
      left: 50%;
      z-index: 12;
      width: min(660px, calc(100vw - 48px));
      max-height: 20vh;
      box-sizing: border-box;
      margin: 0;
      padding: 10px 12px;
      overflow: auto;
      border: 1px solid var(--gaius-shell-line);
      background: #080d11;
      color: var(--gaius-shell-muted);
      font: 11px/1.4 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      letter-spacing: 0;
      transform: translateX(-50%);
      white-space: pre-wrap;
    }


    @media (max-width: 600px) {
      #gaius-shell-header {
        min-height: 48px;
        padding: 0 16px;
      }

      #gaius-shell-version {
        display: none;
      }

      #gaius-shell-footer {
        left: 16px;
        right: 16px;
        bottom: 12px;
      }

      #gaius-shell-footer span:last-child {
        display: none;
      }

      #boot-brand {
        font-size: 46px;
      }

      #gaius-error-actions {
        top: calc(58% + 160px);
      }

      #gaius-error-details {
        top: calc(58% + 208px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #gaius-shell-header,
      #gaius-shell-footer,
      #boot-brand,
      #boot-progress-bar {
        animation: none;
        transition: none;
      }
    }
  </style>
  <style data-gaius-boot-art="v1">
    /* Gaius boot art: Minecraft-style launcher look (port/web/launcher/boot-art.js). */
    html[data-gaius-boot-art="1"] #boot-screen {
      background-color: #1d140d;
      background-image: var(--gaius-boot-dirt);
      background-size: 64px 64px;
      image-rendering: pixelated;
    }

    html[data-gaius-boot-art="1"] #boot-screen::before {
      display: none;
    }

    html[data-gaius-boot-art="1"] #boot-brand {
      position: fixed;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    #gaius-boot-art {
      position: fixed;
      top: 34%;
      left: 50%;
      z-index: 11;
      display: flex;
      flex-direction: column;
      align-items: center;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    #gaius-boot-art canvas,
    #gaius-boot-label,
    #gaius-boot-hint {
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }

    #gaius-boot-logo {
      width: min(736px, 86vw);
      height: auto;
      filter: drop-shadow(0 6px 0 rgba(0, 0, 0, 0.35));
    }

    #gaius-boot-edition {
      margin-top: -14px;
      width: auto;
      height: 24px;
    }

    #gaius-boot-splash {
      position: absolute;
      right: -6%;
      bottom: 22%;
      height: 18px;
      transform: rotate(-18deg);
      transform-origin: center;
      animation: gaius-boot-splash 0.9s ease-in-out infinite alternate;
    }

    @keyframes gaius-boot-splash {
      from { transform: rotate(-18deg) scale(1); }
      to { transform: rotate(-18deg) scale(1.08); }
    }

    html[data-gaius-boot-art="1"] #boot-progress {
      top: 62%;
      width: min(440px, calc(100vw - 64px));
      height: 16px;
      padding: 3px;
      border: 2px solid #ffffff;
      background: rgba(0, 0, 0, 0.35);
    }

    html[data-gaius-boot-art="1"] #boot-progress-bar {
      background: #ffffff;
      transition: width 260ms ease-out;
    }

    html[data-gaius-boot-art="1"] #boot-progress-text {
      position: fixed;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    #gaius-boot-label,
    #gaius-boot-hint {
      position: fixed;
      left: 50%;
      z-index: 11;
      height: 16px;
      transform: translateX(-50%);
      pointer-events: none;
    }

    #gaius-boot-label {
      top: calc(62% + 36px);
    }

    #gaius-boot-hint {
      top: calc(62% + 62px);
    }

    html[data-gaius-boot-art="1"] #status {
      top: calc(62% + 92px);
    }

    html[data-gaius-boot-art="1"] #gaius-shell-header {
      border-bottom-color: rgba(0, 0, 0, 0.6);
      background: rgba(10, 7, 4, 0.72);
    }

    html[data-gaius-shell-view="canvas"] #gaius-boot-art,
    html[data-gaius-shell-view="canvas"] #gaius-boot-label,
    html[data-gaius-shell-view="canvas"] #gaius-boot-hint,
    html[data-gaius-shell-view="profile"] #gaius-boot-art,
    html[data-gaius-shell-view="profile"] #gaius-boot-label,
    html[data-gaius-shell-view="profile"] #gaius-boot-hint {
      display: none;
    }

    html[data-gaius-shell-view="error"] #gaius-boot-label,
    html[data-gaius-shell-view="error"] #gaius-boot-hint {
      display: none;
    }

    @media (max-width: 640px) {
      #gaius-boot-art { top: 30%; }
      #gaius-boot-splash { right: -2%; height: 14px; }
    }

    @media (prefers-reduced-motion: reduce) {
      #gaius-boot-splash { animation: none; }
    }
  </style>
<style>
  :root {
    /* LoadingOverlay's background, and the two colours it draws with. */
    --webmc-bg: #000;
    --webmc-text: #ffffff;
    --webmc-shadow: #3f3f3f;
    --webmc-bar-track: rgba(255, 255, 255, 0.22);
    --webmc-bar-fill: #ffffff;
    --webmc-scale: 2;
    color-scheme: dark;
  }
  html, body { margin: 0; height: 100%; background: var(--webmc-bg); overflow: hidden; }
  /* The window the game draws into. Empty until the engine mounts something. */
  #x11-wasm-root { position: absolute; inset: 0; }
  #webmc-boot {
    position: fixed; inset: 0; z-index: 2147483646; background: var(--webmc-bg);
    display: flex; align-items: center; justify-content: center;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, "DejaVu Sans Mono", monospace;
    font-size: calc(8px * var(--webmc-scale));
    line-height: calc(9px * var(--webmc-scale));
    letter-spacing: 0; text-rendering: geometricPrecision; image-rendering: pixelated;
    -webkit-font-smoothing: none; -moz-osx-font-smoothing: grayscale;
    user-select: none; cursor: default; transition: opacity .25s linear; opacity: 1;
  }
  #webmc-boot.gone { opacity: 0; pointer-events: none; }
  #webmc-boot .panel { text-align: center; }
  #webmc-boot .status {
    color: var(--webmc-text); text-shadow: calc(1px * var(--webmc-scale)) calc(1px * var(--webmc-scale)) 0 var(--webmc-shadow);
    margin: 0 0 calc(10px * var(--webmc-scale));
  }
  /* 200 x 2 at the game's scale: a track with a fill, both crisp, no border radius, no animation
     beyond a width change - the overlay the game draws has none either. */
  #webmc-boot .bar {
    width: calc(200px * var(--webmc-scale)); height: calc(2px * var(--webmc-scale));
    margin: 0 auto; background: var(--webmc-bar-track); overflow: hidden;
  }
  #webmc-boot .bar { position: relative; }
  #webmc-boot .bar > i {
    display: block; width: 0; height: 100%;
    /* the fill never goes backwards: the page uses the highest value it has seen, so a step that
       reports less than the last one cannot make the bar jump back */
    background: linear-gradient(90deg, var(--webmc-bar-fill), #d8f0da);
    transition: width .18s linear;
  }
  #webmc-boot .logo {
    font-size: calc(14px * var(--webmc-scale)); margin: 0 0 calc(14px * var(--webmc-scale));
    color: var(--webmc-text); letter-spacing: calc(2px * var(--webmc-scale));
    text-shadow: calc(2px * var(--webmc-scale)) calc(2px * var(--webmc-scale)) 0 var(--webmc-shadow);
  }
  #webmc-boot .version { color: #ffffff; opacity: .5; margin: calc(6px * var(--webmc-scale)) 0 0;
    font-size: calc(8px * var(--webmc-scale));
    text-shadow: calc(1px * var(--webmc-scale)) calc(1px * var(--webmc-scale)) 0 var(--webmc-shadow); }
  #webmc-boot .note {
    color: var(--webmc-text); opacity: .55; margin: calc(8px * var(--webmc-scale)) 0 0;
    font-size: calc(8px * var(--webmc-scale));
    text-shadow: calc(1px * var(--webmc-scale)) calc(1px * var(--webmc-scale)) 0 var(--webmc-shadow);
  }
  /* The pre-1.13 screen, for anyone who prefers it: the dirt background. Drawn with CSS (a base tone,
     a 16-pixel tile of two tones, and a sparse speckle) so no Mojang texture has to ship with this
     file; a build that has the real texture passes --dirt and it replaces this one entirely. */
  #webmc-boot.dirt {
    background-color: #866043;
    background-image:
      var(--webmc-dirt, none),
      repeating-conic-gradient(from 0deg, #79512f 0% 25%, #8b6547 25% 50%),
      radial-gradient(circle at 30% 30%, #6f4a2b 1.5px, transparent 2px),
      radial-gradient(circle at 70% 65%, #9a7250 1.5px, transparent 2px);
    background-size: calc(16px * var(--webmc-scale)) calc(16px * var(--webmc-scale)),
                     calc(8px * var(--webmc-scale)) calc(8px * var(--webmc-scale)),
                     calc(16px * var(--webmc-scale)) calc(16px * var(--webmc-scale)),
                     calc(16px * var(--webmc-scale)) calc(16px * var(--webmc-scale));
    background-position: 0 0, 0 0, 0 0, calc(8px * var(--webmc-scale)) calc(4px * var(--webmc-scale));
  }
  #webmc-boot.dirt .status, #webmc-boot.dirt .note { color: #ffffff; }
</style>
<style>/* WebMC: the engine's own launcher chrome is not part of this page */
#boot-screen, #gaius-shell-header, #gaius-shell-footer, #gaius-error-details, #profile-kicker, #profile-subtitle, #profile-legal, #status, #log, [data-gaius-shell] { display: none !important; }</style>
</head>
<body>
<div id="webmc-boot">
  <div class="panel">
    <p class="logo" id="webmc-boot-logo">MINECRAFT</p>
    <p class="status">Loading...</p>
    <div class="bar"><i></i></div>
    <p class="version" id="webmc-boot-version"></p>
    <p class="note"></p>
  </div>
</div>
<script>
(function () {
  "use strict";
  var root = document.getElementById("webmc-boot");
  var fill = root.querySelector(".bar > i");
  var status = root.querySelector(".status");
  var note = root.querySelector(".note");
  var style = document.documentElement.style;
  var done = false;
  var value = 0;
  var creep = null;

  /* The game's GUI scale, computed the way it computes it for a small window: the largest whole
   * multiple that still leaves 320 x 240 logical pixels on screen, at least 1 and at most 4. */
  function rescale() {
    var scale = Math.max(1, Math.min(4, Math.floor(Math.min(window.innerWidth / 320, window.innerHeight / 240))));
    style.setProperty("--webmc-scale", String(scale));
  }

  /* The engine reports its progress with its own words, and its words carry its own name: a player read
   * "Starting Gaius Client 1.21.11" on this screen, which is somebody else's product on our loading page. The
   * engine's text is still useful - it says what it is doing - so the name is replaced rather than the message
   * thrown away, and the version is left alone. */
  var ENGINE_NAMES = /(?:gaius|eaglercraft(?:x)?|eagler|eaglerforge|lax1dude|typetheory|browsercraft)[a-z0-9_.-]*/gi;
  var ATTRIBUTION = /not affiliated|independent project|independent browser software/i;
  function clean(text) {
    var line = String(text);
    // An attribution sentence is not progress, and rewriting the name inside it produces a sentence that is
    // worse than no sentence ("Minecraft is not affiliated with Mojang"). The credits live in CREDITS.md; the
    // loading screen keeps the last real progress line instead.
    if (ATTRIBUTION.test(line)) { return ""; }
    return line.replace(ENGINE_NAMES, "Minecraft").replace(/\s+/g, " ").trim();
  }
  var api = {
    show: function (text) {
      root.hidden = false;
      var line = text ? clean(text) : "";
      if (line) { status.textContent = line; }
    },
    /* Monotonic: a step that reports less progress than the last one is ignored rather than shown, which
     * is what "the bar went backwards" always is - two things reporting progress on different scales. */
    progress: function (fraction, text) {
      api.show();
      var next = Math.max(0, Math.min(1, Number(fraction) || 0));
      if (next > value) { value = next; }
      fill.style.width = (value * 100).toFixed(2) + "%";
      var line = text ? clean(text) : "";
      if (line) { status.textContent = line; }
    },
    /* The version being loaded, in the corner, because "Loading…" with no name is a worse wait. */
    version: function (text) {
      var line = document.getElementById("webmc-boot-version");
      if (line) { line.textContent = text || ""; }
    },
    note: function (text) { api.show(); note.textContent = text || ""; },
    ready: function () {
      if (done) { return; }
      done = true;
      if (creep) { clearInterval(creep); creep = null; }
      api.progress(1);
      /* The fade is the only animation, and it is short: the game's own title screen is what the
       * player should be looking at, not this. */
      root.classList.add("gone");
      setTimeout(function () { root.hidden = true; }, 300);
      document.dispatchEvent(new CustomEvent("webmc:booted"));
    },
    get progressValue() { return value; }
  };

  /* No progress reporting? Then the bar creeps toward -50%, which is what the game does while it has
   * nothing to report either (its overlay has the same shape of lie: an indeterminate creep that
   * stops short of the end). It must be replaced by webmcBoot.ready() to reach the end. */
  function beginCreep() {
    if (creep) { return; }
    creep = setInterval(function () {
      if (done) { return; }
      value += (0.5 - value) * 0.02;
      fill.style.width = (value * 100).toFixed(2) + "%";
    }, 100);
  }

  document.addEventListener("webmc:ready", api.ready);
  window.addEventListener("resize", rescale);
  rescale();
  api.show();
  if (window.webmcBootHideOnLoad) { window.addEventListener("load", api.ready); }
  beginCreep();
  window.webmcBoot = api;
})();
</script>

