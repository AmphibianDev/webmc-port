          if (!exports.gaius_repack_interleaved || !repackSourcePtr || !repackOutputPtr || !repackLayoutsPtr) return null;
          const sourceBytes = source && source.byteLength ? source.byteLength >>> 0 : 0;
          const vertices = vertexCount >>> 0;
          const stride = outputStride >>> 0;
