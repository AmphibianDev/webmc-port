    // The branded shell owns only the first client startup. After the first
    // usable main menu, world loading and resource reloads stay vanilla.
    window.__gaiusInitialBootPending = true;

    function setBootProgress(value, label) {
      const next = Math.max(0, Math.min(100, Number(value) || 0));
      if (next >= bootProgressValue || label) {
        bootProgressValue = Math.max(bootProgressValue, next);
        bootProgressLabel = label || bootProgressLabel;
        bootLastProgressAt = performance.now();
        if (bootProgressBar) bootProgressBar.style.width = Math.max(2, bootProgressValue) + "%";
        if (bootProgressText) bootProgressText.textContent = Math.round(bootProgressValue) + "% " + bootProgressLabel;
      }
    }

    window.__gaiusSetBootProgress = setBootProgress;

    function showBootOverlay(label) {
