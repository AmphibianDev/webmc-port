        bootLastProgressAt = performance.now();
        bootWarnedStall = false;
        if (bootProgressBar) bootProgressBar.style.width = "8%";
      }
      if (bootScreen) bootScreen.hidden = false;
      if (bootBrand) bootBrand.hidden = false;
      if (bootProgress) bootProgress.hidden = false;
      if (bootProgressText) bootProgressText.hidden = false;
