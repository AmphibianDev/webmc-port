          if (!exports.gaius_repack_interleaved(sourceBytes, vertices, layoutCount, stride)) return null;
          const outputBytes = exports.gaius_repack_last_bytes ? exports.gaius_repack_last_bytes() >>> 0 : (vertices * stride);
