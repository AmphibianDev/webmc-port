      rafFps: 0,
      frames: 0,
      gameFps: 0,
      gameFrames: 0,
      targetFps,
      lowSamples: 0,
      highSamples: 0,
      degradedCount: 0,
      recoveredCount: 0,
      lastSampleAt: performance.now()
    };
    function maybeDegradeResolutionForFps() {
      const fps = window.__gaiusFps;
      const minecraftState = window.__gaiusMinecraftState || null;
      const inWorld = !!(minecraftState && minecraftState.level);
      const screenName = minecraftState && minecraftState.screen ? String(minecraftState.screen) : "";
      if (screenName.includes("LevelLoadingScreen") || screenName.includes("ProgressScreen")) {
        fps.lowSamples = 0;
        fps.highSamples = 0;
        return;
      }
      const nowMs = performance.now();
      if (inWorld) {
        if (!fps.worldEnteredAt) fps.worldEnteredAt = nowMs;
        if (nowMs - fps.worldEnteredAt < 10000) {
          fps.lowSamples = 0;
          fps.highSamples = 0;
          return;
        }
      } else {
        fps.worldEnteredAt = 0;
      }
      const measured = Number.isFinite(fps.rafFps) && fps.rafFps > 0 ? fps.rafFps : 0;
      if (!Number.isFinite(measured) || measured <= 0) return;
      if (urlParams.has("dpr") || urlParams.has("pixelRatio") || urlParams.get("autoDpr") === "0") return;
      if (fps.lastDprChangeAt && nowMs - fps.lastDprChangeAt < 8000) {
        fps.lowSamples = 0;
        fps.highSamples = 0;
        return;
      }
      const lowTarget = Math.max(45, Math.min(targetFps * 0.70, targetFps - 20));
      const recoveredTarget = Math.max(lowTarget + 10, Math.min(targetFps, lowTarget + 20));
      const defaultMaxDpr = Number(window.__gaiusDefaultMaxDpr) || 1.0;
      if (window.__gaiusMaxDpr < defaultMaxDpr && measured >= recoveredTarget) {
        fps.highSamples++;
        fps.lowSamples = 0;
        if (fps.highSamples >= 5) {
          window.__gaiusMaxDpr = Math.min(
            defaultMaxDpr,
            window.__gaiusMaxDpr < 1.0 ? 1.0 : window.__gaiusMaxDpr + 0.25
          );
          fps.highSamples = 0;
          fps.recoveredCount++;
          fps.lastDprChangeAt = nowMs;
          if (window.__gaiusApplyCanvasResolution) {
            window.__gaiusApplyCanvasResolution(window.innerWidth, window.innerHeight, true);
          }
        }
        return;
      }
      fps.highSamples = 0;
      if (measured < lowTarget) {
        fps.lowSamples++;
      } else if (measured >= recoveredTarget) {
        fps.lowSamples = 0;
      } else {
        fps.lowSamples = Math.max(0, fps.lowSamples - 1);
      }
      const minDpr = inWorld
        ? (Number(window.__gaiusWorldMinDpr) || 1.0)
        : (Number(window.__gaiusMenuMinDpr) || 1.0);
      if (fps.lowSamples < 3 || window.__gaiusMaxDpr <= minDpr) return;
      const nextMaxDpr = Math.round((window.__gaiusMaxDpr - 0.25) * 4) / 4;
      window.__gaiusMaxDpr = Math.max(minDpr, nextMaxDpr);
      fps.lowSamples = 0;
      fps.highSamples = 0;
      fps.degradedCount++;
