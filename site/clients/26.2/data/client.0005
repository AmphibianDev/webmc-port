      const token = urlParams.get("bridgeToken") || urlParams.get("relayToken") || window.__gaiusBridgeToken;
      if (token && String(token).length) bridge.searchParams.set("token", String(token));
      return bridge.href;
    }

    async function loadGaiusMinecraftProfile(accessToken) {
      const response = await fetch(createGaiusProxyUrl(
        "https://api.minecraftservices.com/minecraft/profile",
        "auth"
      ), {
        method: "GET",
        headers: {
          "accept": "application/json",
          "authorization": "Bearer " + accessToken
        },
        cache: "no-store"
      });
      if (!response.ok) {
        throw new Error("Minecraft profile request failed with HTTP " + response.status);
      }
      const profile = await response.json();
      const username = String(profile && profile.name || "").trim();
      const uuid = String(profile && profile.id || "").replace(/-/g, "").toLowerCase();
      if (!/^[A-Za-z0-9_]{1,16}$/.test(username) || !/^[0-9a-f]{32}$/.test(uuid)) {
        throw new Error("Minecraft profile response did not contain a valid Java profile");
      }
      return {username, uuid};
    }

    async function loadGaiusSkinDescriptor(uuid, username) {
      if (!/^[0-9a-f]{32}$/u.test(String(uuid || ""))) return null;
      try {
        const configured = String(window.__gaiusBridgeUrl || "").trim();
        const bridge = new URL(configured || location.href, location.href);
        if (bridge.protocol === "ws:") bridge.protocol = "http:";
        if (bridge.protocol === "wss:") bridge.protocol = "https:";
        bridge.pathname = "/proxy/auth";
        bridge.hash = "";
        bridge.search = "";
        bridge.searchParams.set("url",
          "https://sessionserver.mojang.com/session/minecraft/profile/" + uuid + "?unsigned=false");
        const response = await fetch(bridge.href, {credentials: "omit"});
        if (!response.ok) return null;
        const profile = await response.json();
        if (String(profile?.id || "").replace(/-/g, "").toLowerCase() !== uuid ||
            String(profile?.name || "") !== username) return null;
        const property = Array.isArray(profile?.properties)
          ? profile.properties.find(entry => entry && entry.name === "textures") : null;
        if (!property || typeof property.value !== "string" || !property.value.length) return null;
        return {
          uuid,
          username,
          value: property.value,
          signature: typeof property.signature === "string" ? property.signature : ""
        };
      } catch (_) {
        return null;
      }
    }

    function readGaiusCustomSkin() {
      try {
        const value = localStorage.getItem(GAIUS_CUSTOM_SKIN_KEY) || "";
        return /^data:image\/png;base64,[A-Za-z0-9+/=]+$/u.test(value)
          && value.length <= GAIUS_CUSTOM_SKIN_MAX_DATA_URL ? value : "";
      } catch (error) {
        console.warn("Could not read the saved Gaius custom skin", error);
        return "";
      }
    }

    function readGaiusCustomSkinModel() {
      try {
        return localStorage.getItem(GAIUS_CUSTOM_SKIN_MODEL_KEY) === "slim" ? "slim" : "";
      } catch (error) {
        return "";
      }
    }

    function readGaiusImage(file) {
      return new Promise((resolve, reject) => {
        if (!file || typeof FileReader !== "function" || typeof Image !== "function") {
          reject(new Error("This browser cannot read PNG skin files"));
          return;
        }
        const reader = new FileReader();
        reader.onerror = () => reject(new Error("Could not read the selected skin file"));
        reader.onload = () => {
          const image = new Image();
          image.onerror = () => reject(new Error("The selected file is not a valid PNG image"));
          image.onload = () => resolve({image, source: String(reader.result || "")});
          image.src = String(reader.result || "");
        };
        reader.readAsDataURL(file);
      });
    }

    // Slim (Alex-style) 64x64 skins leave the outer arm column transparent.
    function detectGaiusSlimSkin(context, width, height) {
      if (width !== 64 || height !== 64) return false;
      try {
        return context.getImageData(54, 20, 1, 1).data[3] === 0;
      } catch (error) {
        return false;
      }
    }

    async function decodeGaiusSkinFile(file) {
      if (!file) throw new Error("No skin file was selected");
      if (file.type !== "image/png" && !/\.png$/iu.test(String(file.name || ""))) {
        throw new Error("Choose a PNG skin file.");
      }
      const {image} = await readGaiusImage(file);
      if (!((image.width === 64 && image.height === 64)
          || (image.width === 64 && image.height === 32))) {
        throw new Error("Skin PNG must be 64x64 or 64x32 pixels");
      }
      const canvas = document.createElement("canvas");
      canvas.width = image.width;
      canvas.height = image.height;
      const context = canvas.getContext("2d", {willReadFrequently: true});
      if (!context) throw new Error("Canvas skin decoding is unavailable");
      context.clearRect(0, 0, canvas.width, canvas.height);
      context.drawImage(image, 0, 0);
      const dataUrl = canvas.toDataURL("image/png");
      if (!/^data:image\/png;base64,/u.test(dataUrl)
          || dataUrl.length > GAIUS_CUSTOM_SKIN_MAX_DATA_URL) {
        throw new Error("Skin PNG is too large; use a simple 64x64 skin");
      }
      return {dataUrl, slim: detectGaiusSlimSkin(context, image.width, image.height)};
    }

    function gaiusTexturesValue(dataUrl, slim) {
      if (!dataUrl) return "";
      const skin = {url: dataUrl};
      if (slim) skin.metadata = {model: "slim"};
      const value = btoa(JSON.stringify({textures: {SKIN: skin}}));
      return value.length > 16384 ? "" : value;
    }

    function customGaiusSkinDescriptor(uuid, username) {
      const dataUrl = readGaiusCustomSkin();
      if (!dataUrl || !/^[0-9a-f]{32}$/u.test(String(uuid || ""))
          || !/^[A-Za-z0-9_]{1,16}$/u.test(String(username || ""))) return null;
      const value = gaiusTexturesValue(dataUrl, readGaiusCustomSkinModel() === "slim");
      if (!value) return null;
      return {uuid: String(uuid), username: String(username), value, signature: "", custom: true};
    }

    function generateGaiusDefaultPlayerName() {
      const random = new Uint32Array(1);
      try {
        crypto.getRandomValues(random);
      } catch (error) {
        random[0] = Math.floor(Math.random() * 1e9);
      }
      return "Player" + String(1000 + random[0] % 9000);
    }

    // Relay list for the in-game Relays screen (dev.gaius.browser.BrowserRelays). User relays
    // live in localStorage gaius.bridgeNodes, which the WebSocket channel reads on every
    // connection; built-in relays can only be switched off (gaius.disabledRelays).
    window.__gaiusRelays = (function () {
      function normalize(value) {
        try {
          let text = String(value || "").trim();
          // A bare host ("relay.example.com") means a secure relay.
          if (text && !/^[a-z][a-z0-9+.-]*:/i.test(text)) text = "wss://" + text;
          const parsed = new URL(text, location.href);
          if (parsed.protocol === "http:") parsed.protocol = "ws:";
          if (parsed.protocol === "https:") parsed.protocol = "wss:";
          if (parsed.protocol !== "ws:" && parsed.protocol !== "wss:") return "";
          if (!parsed.hostname) return "";
          if (parsed.pathname === "" || parsed.pathname === "/" ||
              parsed.pathname === "/health" || parsed.pathname === "/relay-node/v1") {
            parsed.pathname = "/tunnel";
          }
          parsed.hash = "";
          parsed.search = "";
          return parsed.href;
        } catch (error) {
          return "";
        }
      }
      function readList(key) {
        try {
          const value = JSON.parse(localStorage.getItem(key) || "[]");
          return Array.isArray(value) ? value : [];
        } catch (error) {
          return [];
        }
      }
      function useOf(value) {
        return value === "multiplayer" || value === "lan" ? value : "both";
      }
      function entryUrl(value) {
        return normalize(value && typeof value === "object" ? (value.url || value.endpoint) : value);
      }
      function entries() {
        const disabled = new Set(readList("gaius.disabledRelays").map(normalize).filter(Boolean));
        const seen = new Set();
        const out = [];
        for (const value of readList("gaius.bridgeNodes")) {
          const url = entryUrl(value);
          if (!url || seen.has(url)) continue;
          seen.add(url);
          const object = value && typeof value === "object" ? value : {};
          out.push({url: url, name: String(object.name || "").slice(0, 80), use: useOf(object.use),
            source: "user", enabled: object.enabled !== false});
        }
        const configured = window.__gaiusBridgeUrls;
        const builtIns = Array.isArray(configured) ? configured : (configured ? [configured] : []);
        for (const value of builtIns) {
          const url = entryUrl(value);
          if (!url || seen.has(url)) continue;
          seen.add(url);
          const object = value && typeof value === "object" ? value : {};
          out.push({url: url, name: String(object.name || "").slice(0, 80), use: "both",
            source: "builtin", enabled: !disabled.has(url)});
        }
        return out;
      }
      return {
        normalize: normalize,
        list: function () {
          return JSON.stringify(entries());
        },
        saveUser: function (json) {
          let values;
          try {
            values = JSON.parse(String(json || "[]"));
          } catch (error) {
            return "Invalid relay list";
          }
          if (!Array.isArray(values)) return "Invalid relay list";
          const saved = [];
          const seen = new Set();
          let priority = 1000;
          for (const value of values) {
            const url = entryUrl(value);
            if (!url || seen.has(url)) continue;
            seen.add(url);
            saved.push({url: url, name: String(value.name || "").slice(0, 80), use: useOf(value.use),
              priority: priority--, user: true});
          }
          try {
            localStorage.setItem("gaius.bridgeNodes", JSON.stringify(saved));
          } catch (error) {
            return "Browser storage is unavailable";
          }
          return "ok";
        },
        setEnabled: function (url, enabled) {
          const target = normalize(url);
          if (!target) return "Invalid relay address";
          const disabled = new Set(readList("gaius.disabledRelays").map(normalize).filter(Boolean));
          if (enabled) disabled.delete(target); else disabled.add(target);
          try {
            localStorage.setItem("gaius.disabledRelays", JSON.stringify(Array.from(disabled)));
          } catch (error) {
            return "Browser storage is unavailable";
          }
          return "ok";
        },
        // The relay a LAN host prefers: the first enabled user relay usable for LAN. Invites
        // carry it so the joining page reaches the same relay (pairing is per relay).
        lanInviteRelay: function () {
          const relay = entries().find(function (entry) {
            return entry.source === "user" && entry.enabled && entry.use !== "multiplayer";
          });
          return relay ? relay.url : "";
        }
      };
    })();

    // Player identity for the in-game Edit Profile screen (dev.gaius.browser.BrowserProfile).
    // Name and skin changes apply to the running client; no page reload is needed.
    window.__gaiusProfile = {
      firstRun: false,
      pick: {state: "idle"},
      savedSkin: readGaiusCustomSkin,
      savedSkinModel: readGaiusCustomSkinModel,
      texturesValue: gaiusTexturesValue,
      pickSkin() {
        const profile = window.__gaiusProfile;
        profile.pick = {state: "pending"};
        const input = document.createElement("input");
        input.type = "file";
        input.accept = "image/png,.png";
        input.style.display = "none";
        let settled = false;
        const finish = result => {
          if (settled) return;
          settled = true;
          profile.pick = result;
          input.remove();
        };
        input.addEventListener("change", () => {
          const file = input.files && input.files[0];
          if (!file) {
            finish({state: "cancelled"});
            return;
          }
          decodeGaiusSkinFile(file).then(
            ({dataUrl, slim}) => finish({state: "done", dataUrl, slim}),
            error => finish({state: "error", error: String(error && error.message || error)})
          );
        });
        input.addEventListener("cancel", () => finish({state: "cancelled"}));
        document.body.appendChild(input);
        input.click();
      },
      apply(name, dataUrl, slim) {
        const online = String(window.__gaiusSessionMode || "offline") === "online";
        let session = {};
        try {
          session = JSON.parse(sessionStorage.getItem("gaius.session") || "{}") || {};
        } catch (error) {
          session = {};
        }
        const username = online ? String(session.username || "") : String(name || "").trim();
        if (!/^[A-Za-z0-9_]{1,16}$/.test(username)) {
          return {ok: false, error: "Use 1-16 letters, numbers or underscores."};
        }
        const skin = String(dataUrl || "");
        if (skin && (!/^data:image\/png;base64,[A-Za-z0-9+/=]+$/u.test(skin)
            || skin.length > GAIUS_CUSTOM_SKIN_MAX_DATA_URL)) {
          return {ok: false, error: "The skin image is not a valid PNG."};
        }
        const uuid = online
          ? String(session.uuid || "").replace(/-/g, "").toLowerCase()
          : offlineGaiusPlayerUuid(username);
        try {
          if (!online) localStorage.setItem("gaius.playerName", username);
          if (skin) {
            localStorage.setItem(GAIUS_CUSTOM_SKIN_KEY, skin);
            localStorage.setItem(GAIUS_CUSTOM_SKIN_MODEL_KEY, slim ? "slim" : "classic");
          } else {
            localStorage.removeItem(GAIUS_CUSTOM_SKIN_KEY);
            localStorage.removeItem(GAIUS_CUSTOM_SKIN_MODEL_KEY);
          }
        } catch (error) {
          return {ok: false, error: "Could not save the profile in this browser."};
        }
        if (!online) {
          session.username = username;
          session.uuid = uuid;
          try {
            sessionStorage.setItem("gaius.session", JSON.stringify(session));
          } catch (error) {
            console.warn("Could not store the updated Gaius session", error);
          }
        }
        window.__gaiusSkinDescriptor = customGaiusSkinDescriptor(uuid, username)
          || (online ? session.skinDescriptor || null : null);
        return {ok: true, uuid};
      }
    };

      // The built-in broker is intentionally a stateless invite: the host
      // Worker has already opened an independent server tunnel for this
      // session, and the joining page connects through the configured relay.
      // Deployments may replace this with __gaiusLanInviteProvider when they
      // want a short URL or an authenticated invite service.
      if (typeof window.__gaiusLanInviteProvider !== "function") {
        window.__gaiusLanInviteProvider = async ({brokerSessionId}) => {
          if (!/^[a-f0-9]{32}$/u.test(String(brokerSessionId || ""))) {
            throw new Error("LAN broker session is invalid");
          }
          const invite = new URL(location.href);
          invite.searchParams.set("server", "client-" + brokerSessionId + ".gaius-local:25565");
          const lanRelay = window.__gaiusRelays && typeof window.__gaiusRelays.lanInviteRelay === "function"
            ? window.__gaiusRelays.lanInviteRelay() : "";
          if (lanRelay) invite.searchParams.set("relay", lanRelay);
          return {url: invite.href};
        };
      }

      // Browser worlds are hosted by a Web Worker.  Keep the LAN action explicit:
      // the invite is relay-backed and carries no access token or world bytes.
      // A deployment can provide __gaiusLanInviteProvider when its LAN broker is
      // enabled; without it the game never advertises a misleading raw TCP port.
      window.__gaiusOpenToLan = async function(identity) {
        const provider = window.__gaiusLanInviteProvider;
        if (typeof provider !== "function") {
          const message = "Open to LAN needs a relay-backed LAN broker for this browser build.";
          try { window.__gaiusMinecraftEvents?.push({event: "lan:unavailable", detail: message}); } catch (_) {}
          if (typeof window.alert === "function") window.alert(message);
          return {ok: false, reason: "lan-broker-unavailable"};
        }
          const invite = await provider({
            profile: String(identity?.profile || window.__gaiusProfileId || "template"),
            username: String(identity?.username || ""),
            brokerSessionId: String(identity?.brokerSessionId || "")
          });
        if (!invite || typeof invite.url !== "string" || !invite.url.trim()) {
          throw new Error("LAN broker returned an invalid invite");
        }
        try { await navigator.clipboard?.writeText(invite.url); } catch (_) {}
        try { window.__gaiusMinecraftEvents?.push({event: "lan:opened", detail: {url: invite.url}}); } catch (_) {}
        if (typeof window.prompt === "function") window.prompt("Open to LAN invite (copied when permitted)", invite.url);
        return {ok: true, url: invite.url};
      };

      const LEGACY_OFFLINE_GAIUS_UUID = "00000000000040008000000000000001";

      function gaiusMd5(input) {
        const shifts = [
          7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
          5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
          4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
          6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
        ];
        const table = new Uint32Array(64);
        for (let i = 0; i < 64; i++) table[i] = Math.floor(Math.abs(Math.sin(i + 1)) * 4294967296);
        const length = input.length;
        const padded = new Uint8Array((((length + 8) >>> 6) + 1) * 64);
        padded.set(input);
        padded[length] = 0x80;
        const view = new DataView(padded.buffer);
        view.setUint32(padded.length - 8, (length * 8) >>> 0, true);
        view.setUint32(padded.length - 4, Math.floor(length / 536870912), true);
        let a0 = 0x67452301, b0 = 0xefcdab89, c0 = 0x98badcfe, d0 = 0x10325476;
        for (let offset = 0; offset < padded.length; offset += 64) {
          let a = a0, b = b0, c = c0, d = d0;
          for (let i = 0; i < 64; i++) {
            let f, g;
            if (i < 16) { f = (b & c) | (~b & d); g = i; }
            else if (i < 32) { f = (d & b) | (~d & c); g = (5 * i + 1) % 16; }
            else if (i < 48) { f = b ^ c ^ d; g = (3 * i + 5) % 16; }
            else { f = c ^ (b | ~d); g = (7 * i) % 16; }
            const sum = (a + f + table[i] + view.getUint32(offset + g * 4, true)) | 0;
            a = d; d = c; c = b;
            b = (b + ((sum << shifts[i]) | (sum >>> (32 - shifts[i])))) | 0;
          }
          a0 = (a0 + a) | 0; b0 = (b0 + b) | 0; c0 = (c0 + c) | 0; d0 = (d0 + d) | 0;
        }
        const out = new Uint8Array(16);
        const outView = new DataView(out.buffer);
        [a0, b0, c0, d0].forEach((word, index) => outView.setUint32(index * 4, word >>> 0, true));
        return out;
      }

      // Same as Java's UUID.nameUUIDFromBytes("OfflinePlayer:" + name). Player
      // names are validated as ASCII [A-Za-z0-9_] before this runs.
      function offlineGaiusPlayerUuid(name) {
        const text = "OfflinePlayer:" + name;
        const bytes = new Uint8Array(text.length);
        for (let i = 0; i < text.length; i++) bytes[i] = text.charCodeAt(i) & 0xff;
        const digest = gaiusMd5(bytes);
        digest[6] = (digest[6] & 0x0f) | 0x30;
        digest[8] = (digest[8] & 0x3f) | 0x80;
        return Array.from(digest, byte => byte.toString(16).padStart(2, "0")).join("");
      }

      async function buildGaiusSessionArgs() {
      let stored = {};
      try {
        const value = sessionStorage.getItem("gaius.session");
        stored = value ? JSON.parse(value) : {};
      } catch (error) {
        console.warn("Ignoring invalid Gaius sessionStorage data", error);
      }
      const injected = window.__gaiusSession && typeof window.__gaiusSession === "object"
        ? window.__gaiusSession
        : {};
      const queried = {};
      for (const key of ["username", "uuid", "accessToken", "xuid", "clientId"]) {
        const value = urlParams.get(key);
        if (value !== null && value.trim()) queried[key] = value.trim();
      }
      const session = Object.assign({}, stored, injected, queried);
      const quickPlayServer = String(urlParams.get("server") || "").trim();
      if (quickPlayServer.length > 512) {
        throw new Error("Quick-play server address is too long");
      }
      const accessToken = String(session.accessToken || "").trim();
      const online = accessToken.length > 0 && accessToken !== "0";
      let username = String(session.username || "").trim();
      let uuid = String(session.uuid || "")
        .replace(/-/g, "")
        .toLowerCase();
      if (username && !/^[A-Za-z0-9_]{1,16}$/.test(username)) {
        throw new Error("Player name must use 1-16 letters, numbers, or underscores");
      }
      if (uuid && !/^[0-9a-f]{32}$/.test(uuid)) {
        throw new Error("Online session UUID must contain 32 hexadecimal digits");
      }
      if (online && (!username || !uuid)) {
        const profile = await loadGaiusMinecraftProfile(accessToken);
        if (!username) username = profile.username;
        if (!uuid) uuid = profile.uuid;
        session.username = username;
        session.uuid = uuid;
        sessionStorage.setItem("gaius.session", JSON.stringify(session));
      }
      if (online && uuid && !session.skinDescriptor) {
        session.skinDescriptor = await loadGaiusSkinDescriptor(uuid, username);
        if (session.skinDescriptor) {
          sessionStorage.setItem("gaius.session", JSON.stringify(session));
        }
      }
      if (!online && !username) {
        let rememberedName = "";
        try {
          rememberedName = localStorage.getItem("gaius.playerName") || "";
        } catch (error) {
          console.warn("Could not read the remembered Gaius player name", error);
        }
        let profileSetupPending = false;
        try {
          profileSetupPending = localStorage.getItem("gaius.profileSetupPending") === "1";
        } catch (error) {
          profileSetupPending = false;
        }
        if (/^[A-Za-z0-9_]{1,16}$/.test(rememberedName)) {
          username = rememberedName;
          // A new player who left before the Edit Profile screen was confirmed or closed
          // still gets it on the next launch (BrowserProfileScreen clears the flag).
          if (profileSetupPending) window.__gaiusProfile.firstRun = true;
        } else {
          // First launch: start straight into the game with a default name; the title
          // screen then opens the in-game Edit Profile screen (BrowserProfileScreen).
          username = generateGaiusDefaultPlayerName();
          try {
            localStorage.setItem("gaius.playerName", username);
            localStorage.setItem("gaius.profileSetupPending", "1");
          } catch (error) {
            console.warn("Could not remember the Gaius player name", error);
          }
          window.__gaiusProfile.firstRun = true;
        }
        session.username = username;
        session.uuid = uuid;
        sessionStorage.setItem("gaius.session", JSON.stringify(session));
      }
      if (!/^[A-Za-z0-9_]{1,16}$/.test(username)) {
        throw new Error("Player name must use 1-16 letters, numbers, or underscores");
      }
      // Offline players get the vanilla name-derived UUID. The old shared
      // placeholder made every LAN joiner collide with the host, which kicked
      // the host ("logged in from another location") and stopped the world.
      if (!online && (!uuid || uuid === LEGACY_OFFLINE_GAIUS_UUID)) {
        uuid = offlineGaiusPlayerUuid(username);
        session.uuid = uuid;
        try {
          sessionStorage.setItem("gaius.session", JSON.stringify(session));
        } catch (error) {
          console.warn("Could not store the offline Gaius player UUID", error);
        }
      }
      const customSkinDescriptor = customGaiusSkinDescriptor(uuid, username);
      window.__gaiusSkinDescriptor = customSkinDescriptor || session.skinDescriptor || null;
      if (!/^[0-9a-f]{32}$/.test(uuid)) {
        throw new Error("Online session UUID must contain 32 hexadecimal digits");
      }
      const args = [
        "--version", "26.2",
        "--versionType", "release",
        "--accessToken", online ? accessToken : "0",
        "--username", username,
        "--uuid", uuid,
        "--gameDir", "/gaius",
        "--assetsDir", "/gaius/assets",
        "--assetIndex", "32",
        "--resourcePackDir", "/gaius/resourcepacks",
        "--width", String(Math.max(854, window.innerWidth || 854)),
        "--height", String(Math.max(480, window.innerHeight || 480))
      ];
      if (online) {
        if (session.xuid) args.push("--xuid", String(session.xuid));
        if (session.clientId) args.push("--clientId", String(session.clientId));
      } else {
        args.push("--offlineDeveloperMode");
      }
      if (quickPlayServer) args.push("--quickPlayMultiplayer", quickPlayServer);
      window.__gaiusSessionMode = online ? "online" : "offline";
      return args;
    }

    window.__gaiusConfigureSession = session => {
      if (!session || typeof session !== "object") throw new TypeError("Session must be an object");
      sessionStorage.setItem("gaius.session", JSON.stringify(session));
    };
    window.__gaiusClearSession = () => sessionStorage.removeItem("gaius.session");
    window.__gaiusDefaultArgsPromise = buildGaiusSessionArgs();
    window.__gaiusDefaultArgsPromise.catch(() => {});
    const identityQueryKeys = ["username", "uuid", "accessToken", "xuid", "clientId"];
    if (identityQueryKeys.some(key => urlParams.has(key))) {
      const scrubbed = new URL(location.href);
      for (const key of identityQueryKeys) scrubbed.searchParams.delete(key);
      history.replaceState(history.state, "", scrubbed.pathname + scrubbed.search + scrubbed.hash);
    }

    const gaiusDiagMode = new URLSearchParams(location.search).get("diag");
    const gaiusTextDiagnosticModes = new Set([
      "texttrace", "nolightmaptext", "textforcefrag", "texttexfrag", "textvertexfrag"
    ]);
    if (gaiusTextDiagnosticModes.has(gaiusDiagMode)) (function installLightweightTextShaderPatch() {
