        const bitStorageInputPtr = exports.gaius_unpack_bit_storage_input_ptr ? exports.gaius_unpack_bit_storage_input_ptr() >>> 0 : 0;
        const bitStorageOutputPtr = exports.gaius_unpack_bit_storage_output_ptr ? exports.gaius_unpack_bit_storage_output_ptr() >>> 0 : 0;
        const bitStorageValueCapacity = exports.gaius_unpack_bit_storage_value_capacity ? exports.gaius_unpack_bit_storage_value_capacity() >>> 0 : 0;
        const bitStorageLongCapacity = exports.gaius_unpack_bit_storage_long_capacity ? exports.gaius_unpack_bit_storage_long_capacity() >>> 0 : 0;
        state.version = exports.gaius_hotpath_version ? exports.gaius_hotpath_version() >>> 0 : 0;
