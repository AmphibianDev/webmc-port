        const repackLayoutsPtr = exports.gaius_repack_layouts_ptr ? exports.gaius_repack_layouts_ptr() >>> 0 : 0;
        const repackSourceCapacity = exports.gaius_repack_source_capacity ? exports.gaius_repack_source_capacity() >>> 0 : 0;
        const repackOutputCapacity = exports.gaius_repack_output_capacity ? exports.gaius_repack_output_capacity() >>> 0 : 0;
