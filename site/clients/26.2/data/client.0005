    });

    setInterval(() => {
      if (!perfHud || !showPerfHud) return;
      const fps = window.__gaiusFps || {};
      const glStats = window.__gaiusGLStats || {};
      const display = window.__gaiusDisplay || {};
      const screen = window.__gaiusMinecraftState?.screen;
      const level = window.__gaiusMinecraftState?.level;
      const shownFps = Number.isFinite(fps.rafFps) && fps.rafFps > 0 ? fps.rafFps : 0;
      const tier = shownFps >= 90 ? "ok" : (shownFps >= 45 ? "warn" : "bad");
      perfHud.dataset.tier = tier;
      perfHud.textContent = [
        "Display FPS " + (shownFps ? shownFps.toFixed(1) : "--") + " / " + targetFps,
        "Game loop " + (fps.gameFps ? fps.gameFps.toFixed(1) : "--"),
        "Draw/s " + (glStats.drawCallsPerSecond ?? "--"),
        "DPR " + (display.pixelRatio ? display.pixelRatio.toFixed(2) : "--")
          + " FB " + (display.framebufferWidth || "--") + "x" + (display.framebufferHeight || "--"),
        "Screen " + (screen ? String(screen).split(".").pop() : (level ? "InGame" : "Loading")),
        fps.degradedCount || fps.recoveredCount
          ? "AutoDPR -" + (fps.degradedCount || 0) + " +" + (fps.recoveredCount || 0)
          : "AutoDPR ready"
      ].join("\n");
    }, 500);

    setInterval(() => {
      if (statusBox.dataset.state !== "running") return;
	      const state = window.__gaiusMinecraftState;
	      const screenName = state && state.screen ? String(state.screen) : "";
	      const titleScreenReady = screenName === "TitleScreen"
	        || screenName.endsWith(".TitleScreen");
	      const titleScreenUsable = titleScreenReady
        && state.running === true
        && state.noRender !== true
        && !state.overlay;
      if (titleScreenUsable) {
	        // The launcher handoff is complete at the first usable main menu.
	        // World creation/join/reload must use Minecraft's own animation.
	        window.__gaiusInitialBootPending = false;
	        hideBootOverlay();
	        return;
	      }
	      if (state && state.level) {
	        window.__gaiusInitialBootPending = false;
	        setBootProgress(100, "World ready");
	        hideBootOverlay();
	        return;
	      }
	      if (window.__gaiusInitialBootPending !== true) {
        hideBootOverlay();
        return;
      }
	      if (state && (state.overlay || state.screen)) {
	        const overlay = state.overlay ? String(state.overlay).split(".").pop() : "";
	        const screen = state.screen ? String(state.screen).split(".").pop() : "";
	        const keepGaiusBootVisible = [
	          "GenericMessageScreen",
	          "ProgressScreen",
	          "LevelLoadingScreen",
	          "ReceivingLevelScreen"
	        ].includes(screen) || overlay === "LoadingOverlay";
	        if (keepGaiusBootVisible) {
	          const loadingLabel = screen === "ReceivingLevelScreen"
	            ? "Connecting to world..."
	            : (screen === "LevelLoadingScreen"
	              ? "Loading world..."
	              : "Loading game resources...");
	          showBootOverlay(loadingLabel);
	          setBootProgress(Math.max(bootProgressValue, 35), loadingLabel);
	          return;
	        }
	        if (screen) {
	          setBootProgress(100, "Client screen ready: " + screen);
	          hideBootOverlay();
	          return;
	        }
	      }
