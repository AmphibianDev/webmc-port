      const fps = window.__gaiusFps;
      const inWorld = !!window.__gaiusMinecraftState?.level;
      if (inWorld && !fps.rafMetricsWorldEnteredAt) {
        fps.rafMetricsWorldEnteredAt = now;
        fps.rafFrameTimes = new Float32Array(4096);
        fps.rafFrameWriteIndex = 0;
        fps.rafFrameCount = 0;
        fps.rafLastFrameAt = 0;
        fps.rafLongestFrameMs = 0;
      } else if (!inWorld) {
        fps.rafMetricsWorldEnteredAt = 0;
      }
      const previousFrameAt = fps.rafLastFrameAt;
      if (Number.isFinite(previousFrameAt) && previousFrameAt > 0) {
        const frameMs = now - previousFrameAt;
        if (Number.isFinite(frameMs) && frameMs > 0 && fps.rafMetricsWorldEnteredAt) {
          let samples = fps.rafFrameTimes;
          if (!(samples instanceof Float32Array) || samples.length !== 4096) {
            samples = new Float32Array(4096);
            fps.rafFrameTimes = samples;
            fps.rafFrameWriteIndex = 0;
            fps.rafFrameCount = 0;
          }
          const writeIndex = (Number(fps.rafFrameWriteIndex) || 0) % samples.length;
          samples[writeIndex] = frameMs;
          fps.rafFrameWriteIndex = (writeIndex + 1) % samples.length;
          fps.rafFrameCount = Math.min(samples.length, (Number(fps.rafFrameCount) || 0) + 1);
          fps.rafLongestFrameMs = Math.max(fps.rafLongestFrameMs || 0, frameMs);
        }
      }
      fps.rafLastFrameAt = now;
      fps.frames++;
      const elapsed = now - fps.lastSampleAt;
      if (elapsed >= 1000) {
        fps.rafFps = Math.round((fps.frames * 1000 / elapsed) * 10) / 10;
        const samples = fps.rafFrameTimes;
        const sampleCount = samples instanceof Float32Array
          ? Math.min(samples.length, Number(fps.rafFrameCount) || 0)
          : 0;
        if (sampleCount > 0) {
          const ordered = Array.from(samples.subarray(0, sampleCount))
            .sort((left, right) => left - right);
          const totalMs = ordered.reduce((sum, value) => sum + value, 0);
          const slowestCount = Math.max(1, Math.ceil(ordered.length * 0.01));
          let slowestTotalMs = 0;
          for (let index = ordered.length - slowestCount; index < ordered.length; index++) {
            slowestTotalMs += ordered[index];
          }
          fps.rafAverageFps = Math.round((ordered.length * 1000 / totalMs) * 10) / 10;
          fps.rafOnePercentLow = Math.round((slowestCount * 1000 / slowestTotalMs) * 10) / 10;
        }
        fps.fps = fps.rafFps;
        fps.frames = 0;
        fps.lastSampleAt = now;
